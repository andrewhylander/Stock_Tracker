# Required for the dashboard to load (Vite bakes these in at build time — set in Vercel and redeploy)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Required for Sync Now (n8n webhook). Without these the UI used to call /undefined/webhook/undefined.
# Example: VITE_N8N_URL=https://n8n.example.com   VITE_N8N_WEBHOOK_ID=abc-123-uuid
VITE_N8N_URL=
VITE_N8N_WEBHOOK_ID=

# Server-side only, used by /api/dividends. NO VITE_ prefix -- anything prefixed
# VITE_ is inlined into the browser bundle, and the service role key must not be.
# SUPABASE_URL is optional -- falls back to VITE_SUPABASE_URL, which is not a
# secret and is already set. The service role key is, and must never be VITE_.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
ALPHAVANTAGE_API_KEY=your-alpha-vantage-key
# Optional. Only needed to bypass the 7-day staleness guard via ?force=1
DIVIDENDS_REFRESH_SECRET=
